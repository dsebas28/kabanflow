        text id PK
        text boardId FK
        text userId FK
        BoardRole role
        timestamp joinedAt
    }
    Message {
        text id PK
        text boardId FK
        text authorId FK
        text body
    }
    Activity {
        text id PK
        text boardId FK
        text actorId FK
        text text
    }
    User ||--o{ Board : "ownerId"
    Board ||--o{ BoardMember : "boardId"
    User ||--o{ BoardMember : "userId"
