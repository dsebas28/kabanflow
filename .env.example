# Copy this file to .env and fill in real values.

# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/kanbanflow"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Port for the custom Socket.io + Next.js server
PORT=3000
